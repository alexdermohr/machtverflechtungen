{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Machtverflechtungen relation record v2",
  "type": "object",
  "required": ["id", "from", "to", "type", "label", "evidence_level", "sources"],
  "properties": {
    "id": {"type": "string", "pattern": "^REL-[A-Z0-9-]+$"},
    "from": {"type": "string"},
    "to": {"type": "string"},
    "type": {"type": "string", "pattern": "^[a-z0-9_]+$"},
    "label": {"type": "string", "minLength": 2},
    "evidence_level": {
      "enum": ["established", "strong", "plausible", "speculative", "contradicted"]
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "pattern": "^SRC-[A-Z0-9-]+$"},
      "uniqueItems": true
    },
    "claim_ids": {
      "type": "array",
      "items": {"type": "string", "pattern": "^CLM-[A-Z0-9-]+$"},
      "uniqueItems": true
    },
    "period": {
      "type": "object",
      "description": "Only the interval directly supported by the cited source; no unstated continuous tenure is implied.",
      "required": ["start"],
      "properties": {
        "start": {"type": "string", "pattern": "^[0-9]{4}(-[0-9]{2}-[0-9]{2})?$"},
        "end": {
          "type": ["string", "null"],
          "pattern": "^[0-9]{4}(-[0-9]{2}-[0-9]{2})?$"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
