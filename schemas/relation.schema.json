{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Machtverflechtungen relation record",
  "type": "object",
  "required": ["id", "from", "to", "type", "label", "evidence_level", "sources"],
  "properties": {
    "id": {"type": "string", "pattern": "^REL-[A-Z0-9-]+$"},
    "from": {"type": "string"},
    "to": {"type": "string"},
    "type": {"type": "string", "pattern": "^[a-z0-9_]+$"},
    "label": {"type": "string", "minLength": 2},
    "evidence_level": {"enum": ["established", "strong", "plausible", "speculative", "contradicted"]},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "pattern": "^SRC-[A-Z0-9-]+$"},
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
