{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alexdermohr.github.io/machtverflechtungen/schemas/case.schema.json",
  "title": "Machtverflechtungen case frontmatter",
  "type": "object",
  "required": [
    "id",
    "type",
    "title",
    "countries",
    "period",
    "status",
    "evidence_level",
    "tags",
    "actors",
    "mechanisms",
    "sources",
    "claims"
  ],
  "properties": {
    "id": {"type": "string", "pattern": "^CASE-[A-Z0-9-]+$"},
    "type": {"const": "case"},
    "title": {"type": "string", "minLength": 3},
    "countries": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "pattern": "^[A-Z]{2}$"},
      "uniqueItems": true
    },
    "period": {
      "type": "object",
      "required": ["start"],
      "properties": {
        "start": {"type": "string"},
        "end": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "status": {"type": "string", "minLength": 2},
    "evidence_level": {
      "enum": ["established", "strong", "plausible", "speculative", "contradicted"]
    },
    "tags": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "actors": {
      "type": "array",
      "items": {"type": "string", "pattern": "^(ORG|PER|PRG)-[A-Z0-9-]+$"},
      "uniqueItems": true
    },
    "mechanisms": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[a-z0-9-]+$"},
      "uniqueItems": true
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "pattern": "^SRC-[A-Z0-9-]+$"},
      "uniqueItems": true
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "object"}
    }
  },
  "additionalProperties": true
}
