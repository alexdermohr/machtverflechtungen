{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alexdermohr.github.io/machtverflechtungen/schemas/case.schema.json",
  "title": "Machtverflechtungen case frontmatter v2",
  "type": "object",
  "$defs": {
    "synthesis_record": {
      "type": "object",
      "required": ["text", "claim_ids"],
      "properties": {
        "text": {"type": "string", "minLength": 10},
        "claim_ids": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "pattern": "^CLM-[A-Z0-9-]+$"},
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "type",
    "title",
    "countries",
    "period",
    "status",
    "research_question",
    "event_claims",
    "tags",
    "actors",
    "mechanisms",
    "sources",
    "claims",
    "what_follows",
    "what_does_not_follow",
    "open_questions",
    "case_links"
  ],
  "properties": {
    "id": {"type": "string", "pattern": "^CASE-[A-Z0-9-]+$"},
    "type": {"const": "case"},
    "title": {"type": "string", "minLength": 3},
    "countries": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "pattern": "^[A-Z]{2}$"},
      "uniqueItems": true
    },
    "period": {
      "type": "object",
      "required": ["start"],
      "properties": {
        "start": {"type": "string"},
        "end": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "status": {"enum": ["draft", "developing", "reviewed"]},
    "research_question": {"type": "string", "minLength": 10},
    "event_claims": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "pattern": "^CLM-[A-Z0-9-]+$"},
      "uniqueItems": true
    },
    "tags": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "actors": {
      "type": "array",
      "items": {"type": "string", "pattern": "^(ORG|PER|PRG)-[A-Z0-9-]+$"},
      "uniqueItems": true
    },
    "mechanisms": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[a-z0-9-]+$"},
      "uniqueItems": true
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "pattern": "^SRC-[A-Z0-9-]+$"},
      "uniqueItems": true
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "object"}
    },
    "what_follows": {
      "type": "array",
      "items": {"$ref": "#/$defs/synthesis_record"}
    },
    "what_does_not_follow": {
      "type": "array",
      "items": {"$ref": "#/$defs/synthesis_record"}
    },
    "open_questions": {
      "type": "array",
      "items": {"type": "string", "minLength": 10}
    },
    "case_links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "target", "basis"],
        "properties": {
          "kind": {"enum": ["comparison", "documented_connection"]},
          "target": {"type": "string", "pattern": "^CASE-[A-Z0-9-]+$"},
          "basis": {"type": "string", "minLength": 10},
          "relation_id": {"type": "string", "pattern": "^REL-[A-Z0-9-]+$"}
        },
        "allOf": [
          {
            "if": {"properties": {"kind": {"const": "documented_connection"}}},
            "then": {"required": ["relation_id"]},
            "else": {"properties": {"relation_id": false}}
          }
        ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}