{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Machtverflechtungen organization frontmatter",
  "type": "object",
  "required": ["id", "type", "title", "countries", "status", "evidence_level", "sources"],
  "properties": {
    "id": {"type": "string", "pattern": "^ORG-[A-Z0-9-]+$"},
    "type": {"const": "organization"},
    "title": {"type": "string", "minLength": 2},
    "countries": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "pattern": "^[A-Z]{2}$"},
      "uniqueItems": true
    },
    "status": {"type": "string", "minLength": 2},
    "evidence_level": {
      "enum": ["established", "strong", "plausible", "speculative", "contradicted"]
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "pattern": "^SRC-[A-Z0-9-]+$"},
      "uniqueItems": true
    }
  },
  "additionalProperties": true
}
