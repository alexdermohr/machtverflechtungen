{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Machtverflechtungen source record",
  "type": "object",
  "required": ["id", "title", "institution", "date", "type", "primary", "tier", "url", "accessed"],
  "properties": {
    "id": {"type": "string", "pattern": "^SRC-[A-Z0-9-]+$"},
    "title": {"type": "string", "minLength": 3},
    "author": {"type": ["string", "null"]},
    "institution": {"type": "string", "minLength": 2},
    "date": {"type": ["string", "integer", "null"]},
    "type": {"type": "string", "minLength": 2},
    "primary": {"type": "boolean"},
    "tier": {"enum": ["A", "B", "C", "D", "E"]},
    "url": {"type": "string", "pattern": "^https://"},
    "archive_url": {"type": ["string", "null"], "pattern": "^https://"},
    "accessed": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "language": {"type": "string", "minLength": 2},
    "locator": {"type": "string"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "local_copy": {"type": "string"},
    "notes": {"type": "string"}
  },
  "additionalProperties": false
}
