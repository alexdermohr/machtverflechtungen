{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Machtverflechtungen entity record",
  "type": "object",
  "required": ["id", "type", "name", "countries"],
  "properties": {
    "id": {"type": "string", "pattern": "^(ORG|PER|PRG)-[A-Z0-9-]+$"},
    "type": {"type": "string", "pattern": "^[a-z0-9_]+$"},
    "name": {"type": "string", "minLength": 2},
    "countries": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Z]{2}$"}
    },
    "notes": {"type": "string"}
  },
  "additionalProperties": false
}
